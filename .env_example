# Django settings
DEBUG=1
SECRET_KEY=your_django_secret_key_here_DO_NOT_COMMIT_ACTUAL_KEY
ALLOWED_HOSTS=localhost 127.0.0.1 taf.local .yourdomain.com # Space separated

# PostgreSQL settings
DB_HOST=db
DB_NAME=taf_db
DB_USER=taf_user
DB_PASSWORD=taf_password
DB_PORT=5432

# Nginx settings (optional, if using variable in nginx.conf)
NGINX_SERVER_NAME=localhost taf.local

# Django Superuser (optional, for entrypoint script if that part is used)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=supersecret
